@startuml
hide circle
class Usuario { id: UUID; email: String; senhaHash: String; papel: Papel }
class Sessao { criadaEm: Instant; ultimaAtividade: Instant }
class Categoria { nome: String; tipo: TipoLancamento; ativa: boolean }
class Lancamento { valor: BigDecimal; data: LocalDate; excluidoEm: Instant }
class MetaOrcamento { mes: String; limite: BigDecimal }
class SugestaoLancamento { dados: JSON; criadaEm: Instant }
class CorrecaoCategoria { termo: String; categoriaConfirmada: UUID }
class RegistroInferencia { modelo: String; latenciaMs: long; custoEstimado: BigDecimal }
class SolicitacaoPrivacidade
interface ProvedorIa
class AdaptadorLlm
class FinanceiroService
class InteligenciaService
Usuario "1" -- "*" Sessao
Usuario "0..1" -- "*" Categoria
Usuario "1" -- "*" Lancamento
Usuario "1" -- "*" MetaOrcamento
Usuario "1" -- "*" SugestaoLancamento
Usuario "1" -- "*" CorrecaoCategoria
Usuario "0..1" -- "*" SolicitacaoPrivacidade
Categoria "1" -- "*" Lancamento
Categoria "1" -- "*" MetaOrcamento
InteligenciaService ..> FinanceiroService
InteligenciaService ..> ProvedorIa
AdaptadorLlm ..|> ProvedorIa
AdaptadorLlm ..> RegistroInferencia
@enduml
