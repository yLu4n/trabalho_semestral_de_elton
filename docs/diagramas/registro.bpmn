<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Finai"
    targetNamespace="https://finai.local/bpmn">
    <bpmn:process id="registro_financeiro" name="Registro de lançamento com revisão humana"
        isExecutable="false">
        <bpmn:laneSet id="raias">
            <bpmn:lane id="titular" name="Usuário titular">
                <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>descrever</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>confirmado</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>manual</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="sistema" name="FinAI">
                <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>valida</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>persistir</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>descartado</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="llm" name="API externa de IA">
                <bpmn:flowNodeRef>interpretar</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="inicio" name="Desejo registrar um movimento" />
        <bpmn:userTask id="descrever" name="Informar frase de até 280 caracteres" />
        <bpmn:serviceTask id="interpretar" name="Interpretar com IA (até duas tentativas)" />
        <bpmn:serviceTask id="validar" name="Validar esquema, categorias e confiança" />
        <bpmn:exclusiveGateway id="valida" name="Sugestão válida?" default="para_manual" />
        <bpmn:userTask id="revisar" name="Revisar e corrigir campos" />
        <bpmn:userTask id="manual" name="Preencher formulário manual com texto original" />
        <bpmn:exclusiveGateway id="confirmado" name="Usuário confirma?" default="descartar" />
        <bpmn:serviceTask id="persistir" name="Salvar lançamento e registrar correção de categoria" />
        <bpmn:endEvent id="fim" name="Painel e orçamento atualizados" />
        <bpmn:endEvent id="descartado" name="Sugestão descartada, sem lançamento" />
        <bpmn:sequenceFlow id="f1" sourceRef="inicio" targetRef="descrever" />
        <bpmn:sequenceFlow id="f2" sourceRef="descrever" targetRef="interpretar" />
        <bpmn:sequenceFlow id="f3" sourceRef="interpretar" targetRef="validar" />
        <bpmn:sequenceFlow id="f4" sourceRef="validar" targetRef="valida" />
        <bpmn:sequenceFlow id="para_revisao" name="Sim" sourceRef="valida" targetRef="revisar">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">respostaValida</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="para_manual" name="Falha, cota ou indisponibilidade"
            sourceRef="valida" targetRef="manual" />
        <bpmn:sequenceFlow id="f5" sourceRef="revisar" targetRef="confirmado" />
        <bpmn:sequenceFlow id="f6" sourceRef="manual" targetRef="confirmado" />
        <bpmn:sequenceFlow id="salvar" name="Confirmação afirmativa" sourceRef="confirmado"
            targetRef="persistir">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmado</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="descartar" name="Descartar" sourceRef="confirmado"
            targetRef="descartado" />
        <bpmn:sequenceFlow id="f7" sourceRef="persistir" targetRef="fim" />
    </bpmn:process>
</bpmn:definitions>