# Copie para .env ou execute python scripts/dev.py configurar.
DATABASE_URL=jdbc:postgresql://localhost:55432/finai
DATABASE_USER=finai
DATABASE_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
PUBLIC_URL=http://localhost:4200
COOKIE_SECURE=false
# file grava e-mails em backend/var/mail SOMENTE no desenvolvimento.
MAIL_MODE=file
MAIL_FROM=nao-responda@finai.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Preços do modelo por milhão de tokens. Zero significa não configurado.
AI_INPUT_COST=0
AI_OUTPUT_COST=0
